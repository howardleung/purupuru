# Clerk: create an application at https://clerk.com and copy its development keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Server-only comma-separated Clerk user IDs allowed to review/commit staged imports.
PURUPURU_ADMIN_CLERK_USER_IDS=user_replace_me

# Neon: use the pooled URL for DATABASE_URL and the direct/unpooled URL for DIRECT_URL.
# The Next.js server needs both values in apps/web/.env.local; Prisma CLI also reads them from packages/database/.env.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Distributed rate limits: server/edge only, never NEXT_PUBLIC_. Provision manually.
# Required in production. Local development may omit both variables; partial configuration is rejected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
